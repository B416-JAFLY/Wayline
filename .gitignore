# Rust workspace and independent firmware build output.
/target/
/firmware/target/
/vendor/owly-awdl/target/
/vendor/owly-airdrop/target/

# ESP-IDF output and generated configuration; keep sdkconfig.defaults* tracked.
/firmware/build/
/firmware/build-*/
/firmware/sdkconfig
/firmware/sdkconfig.cardputer
/firmware/sdkconfig.old
/firmware/sdkconfig.*.old
/firmware/managed_components/

# OWL and local CMake build directories.
cmake-build-*/
CMakeUserPresets.json

# Downloaded dependencies, generated previews and local packaging output.
.cache/
/build/
/dist/

# Python bytecode and virtual environments.
__pycache__/
*.py[cod]
.venv/
/venv/

# Radio captures, logs and temporary files.
*.pcap
*.pcapng
*.log
*.tmp
/temp/
/tmp/

# Editor and local assistant state; keep shared assistant configuration trackable.
.idea/
.vs/
.vscode/
.codegraph/
.claude/settings.local.json

# Local environment values; allow reusable configuration templates.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Operating system metadata.
.DS_Store
Thumbs.db
Desktop.ini

/wintun/
